# NightHawk AI Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ─── Application ───
APP_NAME=NightHawk AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
APP_CORS_ORIGINS=["http://localhost:5173"]

# ─── Database ───
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./nighthawk.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nighthawk

# ─── Authentication ───
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Set this only for the first administrator registration, then remove it from the environment.
ADMIN_BOOTSTRAP_TOKEN=REPLACE_ME_WITH_A_SEPARATE_RANDOM_SECRET
# Development: false for localhost HTTP. Production: true (HTTPS required).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ─── NVIDIA AI ───
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=3
NVIDIA_MAX_TOKENS=4096

# ─── AI Fallback ───
AI_PROVIDER=nvidia
# Options: nvidia, openai, local, mock, fallback
OPENAI_API_KEY=sk-PLACEHOLDER
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ─── Redis (optional) ───
REDIS_URL=redis://localhost:6379/0

# ─── Assessment Limits ───
MAX_CONCURRENT_SCANS=3
MAX_SCAN_DURATION_SECONDS=3600
MAX_REQUESTS_PER_HOST=1000
MAX_ASSESSMENT_ITERATIONS=100
MAX_TOKENS_PER_ASSESSMENT=100000
RATE_LIMIT_REQUESTS_PER_SECOND=10

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FORMAT=json
